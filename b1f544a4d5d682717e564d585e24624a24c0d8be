      },
      "lineNbr": 20,
      "author": {
        "id": 1001562
      },
      "writtenOn": "2024-11-21T21:46:16Z",
      "side": 1,
      "message": "The exact value of the first coefficient (1.164) is 255 / 219.\n\nThe exact value of the second coefficient (1.596) is 255 / 224 * 2 * (1 − 0.299).",
      "revId": "b1f544a4d5d682717e564d585e24624a24c0d8be",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
