      "writtenOn": "2021-11-16T02:59:42Z",
      "side": 1,
      "message": "I\u0027m not sure if we need this extra flag if we rely on WEBP_HAVE_WASM_SIMD",
      "range": {
        "startLine": 84,
        "startChar": 41,
        "endLine": 84,
        "endChar": 62
      },
      "revId": "ed665a15e895ac51b0cec8adcde52b095249dbd6",
