[access]
	inheritFrom = webm
[receive]
	requireChangeId = true
[submit]
	mergeContent = true
[project]
[access "refs/tags/*"]
	createSignedTag = group webm-releasers
[access "refs/heads/*"]
	create = group webm-admins
	push = group webm-admins
	addPatchSet = group open-codecs-scoped-luci-account
	labelAs-Commit-Queue = +0..+1 group open-codecs-scoped-luci-account
	labelAs-Commit-Queue = +0..+1 group webm-committers
	read = group open-codecs-scoped-luci-account
	submit = group ldap/googlers
	submit = group open-codecs-scoped-luci-account
	label-Commit-Queue = +0..+1 group webm-committers
[access "refs/for/*"]
	publishDrafts = group webm-admins
	deleteDrafts = group webm-admins
[access "refs/heads/master"]
	exclusiveGroupPermissions = push submit
[label "Commit-Queue"]
	abbreviation = CQ
	value = 0 Not ready
	value = +1 Dry run
	defaultValue = 0
	function = NoBlock
	copyAllScoresIfNoCodeChange = true
